# ============================================================
# DEGREATLINK — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the real values.
# NEVER commit the `.env` file — it is git-ignored.
#
# Values marked "later phases" are not used by the current
# build yet, but the application is structured around them.

# ------------------------------------------------------------
# Database (PostgreSQL) — used by Prisma
# Provide a hosted Postgres connection string in production
# (e.g. Vercel Postgres, Neon, Supabase, AWS RDS).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------
# Authentication secret — used in later phases (admin auth)
# Generate one with: openssl rand -base64 32
# ------------------------------------------------------------
AUTH_SECRET=

# ------------------------------------------------------------
# Production URL — used by scripts/generate-seo.mjs at build time
# to generate robots.txt and sitemap.xml with the real domain.
# Example: https://degreatlink.com  (no trailing slash)
# ------------------------------------------------------------
PRODUCTION_URL=

# ------------------------------------------------------------
# Client site URL (must be prefixed VITE_ to be exposed to the
# browser at build time). Should match PRODUCTION_URL.
# Used by the Seo component for canonical/OG URLs.
# ------------------------------------------------------------
VITE_SITE_URL=

# ------------------------------------------------------------
# Company contact details — the REAL owner information goes here.
# LEAVE EMPTY until confirmed. The UI automatically hides any
# contact method that is not configured (no placeholders shown).
# ------------------------------------------------------------
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
VITE_SERVICE_AREA=

# ------------------------------------------------------------
# Social media profile URLs — set to your real profiles.
# Leave empty to hide the social icons.
# ------------------------------------------------------------
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_WHATSAPP=

# ------------------------------------------------------------
# Email notifications — used in later phases for contact-form
# email delivery. Provide real SMTP credentials when available.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=
